{
	"name": "ph",
	"private": true,
	"version": "0.0.1",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/Leftium/pH.git"
	},
	"packageManager": "pnpm@11.25.0",
	"type": "module",
	"scripts": {
		"dev": "concurrently --kill-others-on-fail \"pnpm:res:watch\" \"vite dev\"",
		"res:build": "rescript build",
		"res:watch": "rescript watch",
		"build": "pnpm res:build && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "pnpm res:build && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "concurrently --kill-others-on-fail \"pnpm:res:watch\" \"svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch\"",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "pnpm res:build && vitest",
		"test": "pnpm test:unit -- --run"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@leftium/nimble.css": "^0.20.0",
		"@sveltejs/adapter-static": "^4.0.0-next.4",
		"@sveltejs/kit": "^3.0.0-next.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"concurrently": "9.2.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"rescript": "12.3.1",
		"svelte": "^5.56.7",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.1.5",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@rescript/runtime": "12.3.1",
		"tldts-icann": "7.4.11"
	}
}
